#!/usr/bin/env bash
# Actions privilégiées du Centre G-CAD et de Fake Travel (lancé via run0 :
# le mot de passe administrateur est demandé à chaque fois).
set -euo pipefail
source /usr/libexec/gcad/commun.sh

[[ $EUID -eq 0 ]] || { echo "Doit être lancé avec run0." >&2; exit 1; }
install -d -m 755 "$GCAD_ETC"; install -d -m 700 "$GCAD_VAR"
CONF="$GCAD_ETC/reglages.conf"
touch "$CONF"; chmod 644 "$CONF"

regler() {  # regler CLE VALEUR (clés et valeurs contrôlées)
    local cle="$1" val="$2"
    case "$cle" in
        MODE) [[ "$val" =~ ^(simulation|arme)$ ]] ;;
        CONTRAINTE_ACTIF|PORTS_ACTIF|KILLSWITCH|LAN_AUTORISE) [[ "$val" =~ ^[01]$ ]] ;;
        MAX_ESSAIS|DELAI_PORT|ESSAIS_PORT) [[ "$val" =~ ^[0-9]{1,3}$ ]] ;;
        *) false ;;
    esac || { echo "Réglage refusé : $cle=$val" >&2; exit 1; }
    sed -i "/^${cle}=/d" "$CONF"
    echo "${cle}=${val}" >> "$CONF"
}

ACTION="${1:-}"; shift || true
case "$ACTION" in
    regler)          # regler CLE=VAL [CLE=VAL…]
        for kv in "$@"; do regler "${kv%%=*}" "${kv#*=}"; done
        journal "Réglages modifiés : $*"
        ;;
    code)            # code contrainte|ports   (code lu sur l'entrée standard)
        quoi="$1"; [[ "$quoi" =~ ^(contrainte|ports)$ ]]
        IFS= read -r CODE
        [[ ${#CODE} -ge 4 ]] || { echo "Code trop court (4 caractères minimum)." >&2; exit 1; }
        if [[ "$quoi" == contrainte ]]; then
            # Le code de contrainte ne doit jamais être le vrai mot de passe d'un utilisateur
            while IFS=: read -r u _ uid _; do
                (( uid >= 1000 && uid < 60000 )) || continue
                if printf '%s\0' "$CODE" | /usr/sbin/unix_chkpwd "$u" nullok >/dev/null 2>&1; then
                    echo "Ce code est le mot de passe de $u : choisis-en un autre." >&2; exit 1
                fi
            done < /etc/passwd
        fi
        empreinte "$CODE" > "$GCAD_ETC/$quoi.hash"; chmod 600 "$GCAD_ETC/$quoi.hash"
        journal "Code « $quoi » modifié"
        ;;
    ports-confiance) # mémorise les appareils USB branchés maintenant comme « de confiance »
        : > "$GCAD_ETC/ports.autorises"
        for d in /sys/bus/usb/devices/*; do
            [[ -r "$d/idVendor" ]] || continue
            [[ "$(basename "$d")" == usb* ]] && continue
            echo "$(cat "$d/idVendor"):$(cat "$d/idProduct"):$(cat "$d/serial" 2>/dev/null)" >> "$GCAD_ETC/ports.autorises"
        done
        sort -u -o "$GCAD_ETC/ports.autorises" "$GCAD_ETC/ports.autorises"
        journal "Appareils de confiance : $(wc -l < "$GCAD_ETC/ports.autorises")"
        ;;
    vpn-serveurs)    # liste d'adresses IP lue sur l'entrée standard
        grep -E '^[0-9a-fA-F.:/]+$' > "$GCAD_ETC/vpn.serveurs" || true
        journal "Serveurs VPN mis à jour"
        ;;
    appliquer)
        systemctl enable gcad-killswitch.service >/dev/null 2>&1 || true
        /usr/libexec/gcad/killswitch-appliquer
        ;;
    faketravel)      # faketravel <lat> <lon> <fuseau|-> | faketravel off
        if [[ "${1:-}" == off ]]; then
            rm -f /etc/geoclue/conf.d/90-gcad-faketravel.conf /etc/geolocation
            [[ -f "$GCAD_VAR/fuseau.reel" ]] && timedatectl set-timezone "$(cat "$GCAD_VAR/fuseau.reel")" && rm -f "$GCAD_VAR/fuseau.reel"
            journal "Fake Travel désactivé"
        else
            LAT="$1"; LON="$2"; TZ_DEST="${3:--}"
            [[ "$LAT" =~ ^-?[0-9]{1,2}(\.[0-9]+)?$ && "$LON" =~ ^-?[0-9]{1,3}(\.[0-9]+)?$ ]] || { echo "Coordonnées invalides." >&2; exit 1; }
            mkdir -p /etc/geoclue/conf.d
            cat > /etc/geoclue/conf.d/90-gcad-faketravel.conf <<'EOF'
[static-source]
enable=true
[wifi]
enable=false
[ip]
enable=false
[3g]
enable=false
[cdma]
enable=false
[modem-gps]
enable=false
[network-nmea]
enable=false
[compass]
enable=false
EOF
            printf '%s\n%s\n%s\n%s\n' "$LAT" "$LON" 50 100 > /etc/geolocation
            chown geoclue /etc/geolocation 2>/dev/null || true; chmod 600 /etc/geolocation
            if [[ "$TZ_DEST" != "-" ]]; then
                [[ -f "$GCAD_VAR/fuseau.reel" ]] || timedatectl show -p Timezone --value > "$GCAD_VAR/fuseau.reel"
                timedatectl set-timezone "$TZ_DEST"
            fi
            journal "Fake Travel : $LAT, $LON ($TZ_DEST)"
        fi
        systemctl try-restart geoclue.service || true
        ;;
    *)
        echo "Action inconnue." >&2; exit 1 ;;
esac
