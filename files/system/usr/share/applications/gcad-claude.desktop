[Desktop Entry]
Type=Application
Name=Claude
Comment=Assistant IA Claude, dans une fenêtre et un profil séparés
Exec=bash -c 'mkdir -p "$HOME/.local/share/gcad/claude" && exec trivalent --app=https://claude.ai --user-data-dir="$HOME/.local/share/gcad/claude" --no-first-run'
TryExec=trivalent
Icon=internet-chat
Categories=X-GCAD-IA;
Keywords=ia;ai;assistant;claude;
