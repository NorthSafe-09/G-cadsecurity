[Unit]
Description=G-CAD : installe Alpaca (interface pour Ollama et autres IA) une seule fois
After=secureblue-flatpak-setup.service
ConditionUser=!@system
ConditionPathExists=!%h/.local/share/gcad/alpaca-ok
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'flatpak remotes --user --columns=name | grep -qx flathub && flatpak install --user --noninteractive -y flathub com.jeffser.Alpaca'
ExecStartPost=/usr/bin/bash -c 'mkdir -p %h/.local/share/gcad && touch %h/.local/share/gcad/alpaca-ok'
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
